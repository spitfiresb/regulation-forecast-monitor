# Optional until a Supabase project is created. Server-only; never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role keys are also accepted via SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Required for live AI research and forecasts. Source facts remain separate.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Set the deployed app's exact origin. Leave empty for local development.
APP_ORIGIN=
# Optional bearer token for server-to-server activity assessment requests.
SYNC_SECRET=
# Without Supabase, refreshed data is saved here (local development only).
LOCAL_DATA_DIR=.data
